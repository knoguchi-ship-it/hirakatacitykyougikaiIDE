{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs\"",
            "timeout": 15,
            "statusMessage": "固定デプロイ・push ゲートを確認しています"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-write.mjs\"",
            "timeout": 15,
            "statusMessage": "資格情報ファイルでないか確認しています"
          }
        ]
      }
    ]
  }
}
