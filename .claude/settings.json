{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs\"",
            "timeout": 15,
            "statusMessage": "固定デプロイ・push ゲートを確認しています"
          }
        ]
      },
      {
        "matcher": "mcp__git__git_commit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs\"",
            "timeout": 15,
            "statusMessage": "仕様書の追従確認（Spec: 行）を確認しています"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_evaluate|mcp__playwright__browser_run_code",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-browser.mjs\"",
            "timeout": 15,
            "statusMessage": "ブラウザから本番を書き換えないか確認しています"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-write.mjs\"",
            "timeout": 15,
            "statusMessage": "資格情報ファイルでないか確認しています"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "input=$(cat); printf '%s' \"$input\" | grep -qiE 'ハンドオフ|引き?継|引継|まとめて閉じ|区切|handoff|\\u' || exit 0; printf '%s' \"$input\" | node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-handoff-prompt.mjs\"",
            "timeout": 10,
            "statusMessage": "ハンドオフの指示か確認しています"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "test -f \"${CLAUDE_PROJECT_DIR}/.tmp/handoff-pending.json\" || exit 0; node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-handoff-stop.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-cross-agent-review.mjs\" claude",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
