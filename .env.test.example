# Test credentials (gitignored as .env.test)
# Copy this to .env.test and fill in the values.

# Member portal credentials (REQUIRED — script fails fast without these)
# Use a non-production demo account such as demo-ind-002 / demo1234
# (do NOT use demo-ind-001 — locked from past failed iterations).
MEMBER_LOGIN_ID=
MEMBER_PASSWORD=

# Optional URL overrides (uses HANDOVER values by default)
