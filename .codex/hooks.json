{
  "description": "ClaudeCode と同じリポジトリ安全ガードを Codex でも実行する。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/run-claude-guard.mjs\" guard-bash.mjs",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand JgAgACgASgBvAGkAbgAtAFAAYQB0AGgAIAAoACgAZwBpAHQAIAByAGUAdgAtAHAAYQByAHMAZQAgAC0ALQBzAGgAbwB3AC0AdABvAHAAbABlAHYAZQBsACkALgBUAHIAaQBtACgAKQApACAAJwAuAGMAbwBkAGUAeAAvAHIAdQBuAC0AYwBsAGEAdQBkAGUALQBnAHUAYQByAGQALgBwAHMAMQAnACkAIAAnAGcAdQBhAHIAZAAtAGIAYQBzAGgALgBtAGoAcwAnAA==",
            "timeout": 15,
            "statusMessage": "デプロイ・push・本番書込みを確認しています"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_evaluate|mcp__playwright__browser_run_code",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/run-claude-guard.mjs\" guard-browser.mjs",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand JgAgACgASgBvAGkAbgAtAFAAYQB0AGgAIAAoACgAZwBpAHQAIAByAGUAdgAtAHAAYQByAHMAZQAgAC0ALQBzAGgAbwB3AC0AdABvAHAAbABlAHYAZQBsACkALgBUAHIAaQBtACgAKQApACAAJwAuAGMAbwBkAGUAeAAvAHIAdQBuAC0AYwBsAGEAdQBkAGUALQBnAHUAYQByAGQALgBwAHMAMQAnACkAIAAnAGcAdQBhAHIAZAAtAGIAcgBvAHcAcwBlAHIALgBtAGoAcwAnAA==",
            "timeout": 15,
            "statusMessage": "ブラウザ経由の本番書込みを確認しています"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/guard-write.mjs\"",
            "timeout": 15,
            "statusMessage": "機密ファイルへの書込みを確認しています"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); printf '%s' \"$input\" | grep -qiE 'ハンドオフ|引き?継|引継|まとめて閉じ|区切|handoff|\\\\u' || exit 0; r=\"$(git rev-parse --show-toplevel)\"; printf '%s' \"$input\" | CODEX_HOOK_RUNTIME=1 node \"$r/.claude/hooks/guard-handoff-prompt.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 10,
            "statusMessage": "ハンドオフの指示か確認しています"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"$(git rev-parse --show-toplevel)\"; s=\"${GUARD_STATE_ROOT:-$r}\"; test -f \"$s/.tmp/handoff-pending.json\" || { echo '{}'; exit 0; }; CODEX_HOOK_RUNTIME=1 node \"$r/.claude/hooks/guard-handoff-stop.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
